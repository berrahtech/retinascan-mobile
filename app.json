{
  "expo": {
    "name": "RetinaScan",
    "slug": "retinascan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "retinascan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#070B16",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.retinascan.app",
      "infoPlist": {
        "NSCameraUsageDescription": "RetinaScan utilise l'appareil photo pour capturer une image du fond d'œil et l'analyser.",
        "NSPhotoLibraryUsageDescription": "RetinaScan accède à vos photos pour analyser une image de rétine existante.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.retinascan.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070B16"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "RetinaScan utilise l'appareil photo pour capturer une image du fond d'œil et l'analyser.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RetinaScan accède à vos photos pour analyser une image de rétine existante."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070B16"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
